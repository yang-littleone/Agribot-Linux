<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Gazebo-specific configurations for agribot -->

    <!-- Define the robot's friction properties -->
    <gazebo reference="base_link">
        <mu1>0.8</mu1>
        <mu2>0.8</mu2>
    </gazebo>

    <gazebo reference="lf_wheel_link">
        <mu1>1.5</mu1>
        <mu2>0.8</mu2>
        <kp>1000000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>5.0</maxVel>
    </gazebo>

    <gazebo reference="rf_wheel_link">
        <mu1>1.5</mu1>
        <mu2>0.8</mu2>
        <kp>1000000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>5.0</maxVel>
    </gazebo>

    <gazebo reference="lb_wheel_link">
        <mu1>1.5</mu1>
        <mu2>0.8</mu2>
        <kp>1000000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>5.0</maxVel>
    </gazebo>

    <gazebo reference="rb_wheel_link">
        <mu1>1.5</mu1>
        <mu2>0.8</mu2>
        <kp>1000000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>5.0</maxVel>
    </gazebo>

    <!-- Define colors for Gazebo -->
    <gazebo reference="base_link">
        <material>Gazebo/Blue</material>
    </gazebo>

    <gazebo reference="lf_wheel_link">
        <material>Gazebo/White</material>
    </gazebo>

    <gazebo reference="rf_wheel_link">
        <material>Gazebo/White</material>
    </gazebo>

    <gazebo reference="lb_wheel_link">
        <material>Gazebo/White</material>
    </gazebo>

    <gazebo reference="rb_wheel_link">
        <material>Gazebo/White</material>
    </gazebo>

    <gazebo reference="laser_link">
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="controller_link">
        <material>Gazebo/White</material>
    </gazebo>

    <gazebo reference="camera_link">
        <material>Gazebo/White</material>
    </gazebo>

