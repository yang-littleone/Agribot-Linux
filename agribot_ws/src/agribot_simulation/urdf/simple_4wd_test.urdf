<?xml version="1.0"?>
<robot name="simple_4wd_test" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- 基本参数 -->
    <xacro:property name="base_length" value="0.2"/>
    <xacro:property name="base_width" value="0.15"/>
    <xacro:property name="base_height" value="0.08"/>
    <xacro:property name="wheel_radius" value="0.05"/>
    <xacro:property name="wheel_thickness" value="0.03"/>
    <xacro:property name="wheel_separation" value="0.2"/>
    <xacro:property name="mass_base" value="5.0"/>
    <xacro:property name="mass_wheel" value="0.5"/>

    <!-- Base Link -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 0.8 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="${mass_base}"/>
            <inertia ixx="${mass_base/12 * (base_width*base_width + base_height*base_height)}" 
                     ixy="0" ixz="0"
                     iyy="${mass_base/12 * (base_length*base_length + base_height*base_height)}" 
                     iyz="0"
                     izz="${mass_base/12 * (base_length*base_length + base_width*base_width)}"/>
        </inertial>
    </link>

    <!-- Left Front Wheel -->
    <link name="lf_wheel">
        <visual>
            <origin rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
            <material name="white">
                <color rgba="1 1 1 1"/>
            </material>
        </visual>
        <collision>
            <origin rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="${mass_wheel}"/>
            <inertia ixx="${mass_wheel/12 * (3*wheel_radius*wheel_radius + wheel_thickness*wheel_thickness)}"
                     ixy="0" ixz="0"
                     iyy="${mass_wheel/2 * wheel_radius*wheel_radius}"
                     iyz="0"
                     izz="${mass_wheel/12 * (3*wheel_radius*wheel_radius + wheel_thickness*wheel_thickness)}"/>
        </inertial>
    </link>

    <joint name="lf_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="lf_wheel"/>
        <origin xyz="${base_length/2 - wheel_radius} ${wheel_separation/2} ${-wheel_radius + base_height/2}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- Left Back Wheel -->
    <link name="lb_wheel">
        <visual>
            <origin rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
            <material name="white">
                <color rgba="1 1 1 1"/>
            </material>
        </visual>
        <collision>
            <origin rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="${mass_wheel}"/>
            <inertia ixx="${mass_wheel/12 * (3*wheel_radius*wheel_radius + wheel_thickness*wheel_thickness)}"
                     ixy="0" ixz="0"
                     iyy="${mass_wheel/2 * wheel_radius*wheel_radius}"
                     iyz="0"
                     izz="${mass_wheel/12 * (3*wheel_radius*wheel_radius + wheel_thickness*wheel_thickness)}"/>
        </inertial>
    </link>

    <joint name="lb_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="lb_wheel"/>
        <origin xyz="${-base_length/2 + wheel_radius} ${wheel_separation/2} ${-wheel_radius + base_height/2}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- Right Front Wheel -->
    <link name="rf_wheel">
        <visual>
            <origin rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
            <material name="white">
                <color rgba="1 1 1 1"/>
            </material>
        </visual>
        <collision>
            <origin rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="${mass_wheel}"/>
            <inertia ixx="${mass_wheel/12 * (3*wheel_radius*wheel_radius + wheel_thickness*wheel_thickness)}"
                     ixy="0" ixz="0"
                     iyy="${mass_wheel/2 * wheel_radius*wheel_radius}"
                     iyz="0"
                     izz="${mass_wheel/12 * (3*wheel_radius*wheel_radius + wheel_thickness*wheel_thickness)}"/>
        </inertial>
    </link>

    <joint name="rf_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rf_wheel"/>
        <origin xyz="${base_length/2 - wheel_radius} ${-wheel_separation/2} ${-wheel_radius + base_height/2}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- Right Back Wheel -->
    <link name="rb_wheel">
        <visual>
            <origin rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
            <material name="white">
                <color rgba="1 1 1 1"/>
            </material>
        </visual>
        <collision>
            <origin rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="${mass_wheel}"/>
            <inertia ixx="${mass_wheel/12 * (3*wheel_radius*wheel_radius + wheel_thickness*wheel_thickness)}"
                     ixy="0" ixz="0"
                     iyy="${mass_wheel/2 * wheel_radius*wheel_radius}"
                     iyz="0"
                     izz="${mass_wheel/12 * (3*wheel_radius*wheel_radius + wheel_thickness*wheel_thickness)}"/>
        </inertial>
    </link>

    <joint name="rb_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rb_wheel"/>
        <origin xyz="${-base_length/2 + wheel_radius} ${-wheel_separation/2} ${-wheel_radius + base_height/2}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- Gazebo物理属性 -->
    <gazebo reference="base_link">
        <mu1>0.8</mu1>
        <mu2>0.8</mu2>
        <material>Gazebo/Blue</material>
    </gazebo>

    <gazebo reference="lf_wheel">
        <mu1>1.0</mu1>
        <mu2>0.5</mu2>
        <kp>1000000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>5.0</maxVel>
        <material>Gazebo/White</material>
    </gazebo>

    <gazebo reference="lb_wheel">
        <mu1>1.0</mu1>
        <mu2>0.5</mu2>
        <kp>1000000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>5.0</maxVel>
        <material>Gazebo/White</material>
    </gazebo>

    <gazebo reference="rf_wheel">
        <mu1>1.0</mu1>
        <mu2>0.5</mu2>
        <kp>1000000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>5.0</maxVel>
        <material>Gazebo/White</material>
    </gazebo>

    <gazebo reference="rb_wheel">
        <mu1>1.0</mu1>
        <mu2>0.5</mu2>
        <kp>1000000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>5.0</maxVel>
        <material>Gazebo/White</material>
    </gazebo>

    <!-- ROS2 Control配置 -->
    <ros2_control name="Simple4WDSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>
        
        <joint name="lf_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <command_interface name="effort">
                <param name="min">-5</param>
                <param name="max">5</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="lb_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <command_interface name="effort">
                <param name="min">-5</param>
                <param name="max">5</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="rf_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <command_interface name="effort">
                <param name="min">-5</param>
                <param name="max">5</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="rb_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <command_interface name="effort">
                <param name="min">-5</param>
                <param name="max">5</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </ros2_control>

    <!-- Gazebo插件 -->
    <gazebo>
        <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
            <robot_param>robot_description</robot_param>
            <robot_param_node>robot_state_publisher</robot_param_node>
            <parameters>$(find agribot_simulation)/config/simple_4wd_controller.yaml</parameters>
            <ros>
                <remapping>/simple_4wd_diff_drive_controller/cmd_vel_unstamped:=/cmd_vel</remapping>
                <remapping>/simple_4wd_diff_drive_controller/odom:=/odom</remapping>
            </ros>
        </plugin>
    </gazebo>

</robot>
