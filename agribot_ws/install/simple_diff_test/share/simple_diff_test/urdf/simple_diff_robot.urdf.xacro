<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="simple_diff_robot">

  <!-- ==================== 参数定义 ==================== -->
  <xacro:property name="base_length" value="0.20"/>
  <xacro:property name="base_width" value="0.15"/>
  <xacro:property name="base_height" value="0.05"/>
  <xacro:property name="base_mass" value="1.0"/>

  <xacro:property name="wheel_radius" value="0.032"/>
  <xacro:property name="wheel_width" value="0.02"/>
  <xacro:property name="wheel_mass" value="0.05"/>

  <!-- 轮子位置（相对于base_link中心） -->
  <xacro:property name="wheel_x_offset" value="0.07"/>
  <xacro:property name="wheel_y_offset" value="0.075"/>
  <xacro:property name="wheel_z_offset" value="-0.025"/>

  <!-- ==================== 惯性矩宏 ==================== -->
  <!-- 长方体惯性矩 -->
  <xacro:macro name="box_inertia" params="m l w h">
    <inertial>
      <mass value="${m}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${m * (h*h + w*w) / 12.0}"
        ixy="0" ixz="0"
        iyy="${m * (l*l + h*h) / 12.0}"
        iyz="0"
        izz="${m * (l*l + w*w) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- 圆柱体惯性矩（轴向沿Y轴） -->
  <xacro:macro name="cylinder_inertia_y" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${m * (3*r*r + h*h) / 12.0}"
        ixy="0" ixz="0"
        iyy="${m * r*r / 2.0}"
        iyz="0"
        izz="${m * (3*r*r + h*h) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- ==================== Link定义 ==================== -->

  <!-- 虚拟根节点 -->
  <link name="base_footprint"/>

  <!-- 机器人基座 -->
  <link name="base_link">
    <xacro:box_inertia m="${base_mass}" l="${base_length}" w="${base_width}" h="${base_height}"/>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- 左前轮 -->
  <link name="lf_wheel_link">
    <xacro:cylinder_inertia_y m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>

    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
  </link>

  <!-- 左后轮 -->
  <link name="lb_wheel_link">
    <xacro:cylinder_inertia_y m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>

    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="white"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
  </link>

  <!-- 右前轮 -->
  <link name="rf_wheel_link">
    <xacro:cylinder_inertia_y m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>

    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="white"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
  </link>

  <!-- 右后轮 -->
  <link name="rb_wheel_link">
    <xacro:cylinder_inertia_y m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>

    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="white"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== Joint定义 ==================== -->

  <!-- base_footprint -> base_link -->
  <joint name="base_joint" type="fixed">
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <!-- 左前轮关节 -->
  <joint name="lf_wheel_joint" type="continuous">
    <origin xyz="${wheel_x_offset} ${wheel_y_offset} ${wheel_z_offset}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lf_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 左后轮关节 -->
  <joint name="lb_wheel_joint" type="continuous">
    <origin xyz="-${wheel_x_offset} ${wheel_y_offset} ${wheel_z_offset}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lb_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 右前轮关节 -->
  <joint name="rf_wheel_joint" type="continuous">
    <origin xyz="${wheel_x_offset} -${wheel_y_offset} ${wheel_z_offset}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rf_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 右后轮关节 -->
  <joint name="rb_wheel_joint" type="continuous">
    <origin xyz="-${wheel_x_offset} -${wheel_y_offset} ${wheel_z_offset}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rb_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ==================== 包含其他配置 ==================== -->
  <xacro:include filename="$(find simple_diff_test)/urdf/simple_diff_robot.gazebo.xacro"/>
  <xacro:include filename="$(find simple_diff_test)/urdf/simple_diff_robot.ros2_control.xacro"/>

</robot>
