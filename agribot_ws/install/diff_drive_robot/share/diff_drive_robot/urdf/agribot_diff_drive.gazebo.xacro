<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Gazebo-specific material and friction properties only -->
  <!-- Diff drive is handled by gazebo_ros2_control -->

  <!-- Chassis Gazebo properties -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <!-- Controller Gazebo properties -->
  <gazebo reference="controller_link">
    <material>Gazebo/White</material>
  </gazebo>

  <!-- Wheel Gazebo properties -->
  <gazebo reference="wheel_lf_link">
    <material>Gazebo/Black</material>
    <mu1>1.5</mu1>
    <mu2>0.8</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>5.0</maxVel>
  </gazebo>

  <gazebo reference="wheel_lb_link">
    <material>Gazebo/Black</material>
    <mu1>1.5</mu1>
    <mu2>0.8</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>5.0</maxVel>
  </gazebo>

  <gazebo reference="wheel_rf_link">
    <material>Gazebo/Black</material>
    <mu1>1.5</mu1>
    <mu2>0.8</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>5.0</maxVel>
  </gazebo>

  <gazebo reference="wheel_rb_link">
    <material>Gazebo/Black</material>
    <mu1>1.5</mu1>
    <mu2>0.8</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>5.0</maxVel>
  </gazebo>

</robot>
