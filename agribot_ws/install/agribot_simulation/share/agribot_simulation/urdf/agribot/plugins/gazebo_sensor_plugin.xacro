<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="gazebo_sensor_plugin">
        <!-- 3D激光雷达传感器 (Livox Mid-360) -->
        <gazebo reference="laser_link">
            <sensor name="laser_3d" type="ray">
                <plugin name="laser_3d" filename="libgazebo_ros_ray_sensor.so">
                    <ros>
                        <namespace>/</namespace>
                        <remapping>~/out:=scan_3d</remapping>
                    </ros>
                    <output_type>sensor_msgs/PointCloud2</output_type>
                    <frame_name>laser_link</frame_name>
                </plugin>
                <always_on>true</always_on>
                <visualize>false</visualize>
                <update_rate>10</update_rate>
                <pose>0 0 0 0 0 0</pose>

                <!-- 3D激光传感器配置 -->
                <ray>
                    <!-- 水平扫描范围 (360°) -->
                    <scan>
                        <horizontal>
                            <samples>360</samples>
                            <resolution>1</resolution>
                            <min_angle>0</min_angle>
                            <max_angle>6.28319</max_angle>
                        </horizontal>
                        <!-- 垂直扫描范围 (-7°~52°) -->
                        <vertical>
                            <samples>59</samples>
                            <resolution>1</resolution>
                            <min_angle>-0.12217</min_angle>
                            <max_angle>0.90757</max_angle>
                        </vertical>
                    </scan>

                    <!-- 扫描距离范围 (0.1m-70m) -->
                    <range>
                        <min>0.1</min>
                        <max>70.0</max>
                        <resolution>0.01</resolution>
                    </range>

                    <!-- 噪声设置 -->
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.02</stddev>
                    </noise>
                </ray>
            </sensor>
        </gazebo>
    </xacro:macro>
</robot>