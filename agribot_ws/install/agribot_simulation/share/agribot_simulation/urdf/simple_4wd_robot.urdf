<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="simple_4wd_robot">
    
    <!-- 基础链接 -->
    <link name="base_footprint"/>
    
    <joint name="base_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="base_footprint"/>
        <child link="base_link"/>
    </joint>
    
    <!-- 底盘 - 尺寸与agribot一致 (长0.2m, 宽0.18m) -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <geometry>
                <box size="0.2 0.18 0.1"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <geometry>
                <box size="0.2 0.18 0.1"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <mass value="5.0"/>
            <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.05"/>
        </inertial>
    </link>
    
    <!-- 左前轮 -->
    <link name="lf_wheel_link">
        <visual>
            <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
            <geometry>
                <cylinder radius="0.032" length="0.02"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
            <geometry>
                <cylinder radius="0.032" length="0.02"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.5"/>
            <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
        </inertial>
    </link>
    
    <joint name="lf_wheel_joint" type="continuous">
        <origin xyz="0.08 0.09 -0.02" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="lf_wheel_link"/>
        <axis xyz="0 1 0"/>
    </joint>
    
    <!-- 左后轮 -->
    <link name="lb_wheel_link">
        <visual>
            <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
            <geometry>
                <cylinder radius="0.032" length="0.02"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
            <geometry>
                <cylinder radius="0.032" length="0.02"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.5"/>
            <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
        </inertial>
    </link>
    
    <joint name="lb_wheel_joint" type="continuous">
        <origin xyz="-0.08 0.09 -0.02" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="lb_wheel_link"/>
        <axis xyz="0 1 0"/>
    </joint>
    
    <!-- 右前轮 -->
    <link name="rf_wheel_link">
        <visual>
            <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
            <geometry>
                <cylinder radius="0.032" length="0.02"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
            <geometry>
                <cylinder radius="0.032" length="0.02"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.5"/>
            <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
        </inertial>
    </link>
    
    <joint name="rf_wheel_joint" type="continuous">
        <origin xyz="0.08 -0.09 -0.02" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="rf_wheel_link"/>
        <axis xyz="0 1 0"/>
    </joint>
    
    <!-- 右后轮 -->
    <link name="rb_wheel_link">
        <visual>
            <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
            <geometry>
                <cylinder radius="0.032" length="0.02"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
            <geometry>
                <cylinder radius="0.032" length="0.02"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.5"/>
            <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
        </inertial>
    </link>
    
    <joint name="rb_wheel_joint" type="continuous">
        <origin xyz="-0.08 -0.09 -0.02" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="rb_wheel_link"/>
        <axis xyz="0 1 0"/>
    </joint>
    
    <!-- Gazebo ROS2 Control 插件 -->
    <gazebo>
        <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
            <parameters>/home/xkai/agribot/agribot_ws/install/agribot_simulation/share/agribot_simulation/config/simple_4wd_controller.yaml</parameters>
            <ros>
                <remapping>/simple_4wd_controller/cmd_vel_unstamped:=/cmd_vel</remapping>
                <remapping>/simple_4wd_controller/odom:=/odom</remapping>
            </ros>
        </plugin>
    </gazebo>
    
    <!-- Gazebo 物理属性 -->
    <gazebo reference="base_link">
        <mu1>0.5</mu1>
        <mu2>0.5</mu2>
        <kp>1000000.0</kp>
        <kd>10.0</kd>
    </gazebo>
    
    <!-- 轮子摩擦系数 - 降低以减少旋转阻力 -->
    <gazebo reference="lf_wheel_link">
        <mu1>1.0</mu1>
        <mu2>0.5</mu2>
        <kp>1000000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>1.0</maxVel>
    </gazebo>
    
    <gazebo reference="lb_wheel_link">
        <mu1>1.0</mu1>
        <mu2>0.5</mu2>
        <kp>1000000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>1.0</maxVel>
    </gazebo>
    
    <gazebo reference="rf_wheel_link">
        <mu1>1.0</mu1>
        <mu2>0.5</mu2>
        <kp>1000000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>1.0</maxVel>
    </gazebo>
    
    <gazebo reference="rb_wheel_link">
        <mu1>1.0</mu1>
        <mu2>0.5</mu2>
        <kp>1000000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>1.0</maxVel>
    </gazebo>
    
    <!-- ros2_control 硬件接口定义 -->
    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>
        
        <joint name="lf_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <command_interface name="effort">
                <param name="min">-5.0</param>
                <param name="max">5.0</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
        
        <joint name="lb_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <command_interface name="effort">
                <param name="min">-5.0</param>
                <param name="max">5.0</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
        
        <joint name="rf_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <command_interface name="effort">
                <param name="min">-5.0</param>
                <param name="max">5.0</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
        
        <joint name="rb_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
            <command_interface name="effort">
                <param name="min">-5.0</param>
                <param name="max">5.0</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
    </ros2_control>
    
</robot>
